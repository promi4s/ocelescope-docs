---
interface Props {
    src: string;
    caption?: string;
}

const { src, caption } = Astro.props;
---

<video
    class="video-media"
    src={src}
    autoplay
    loop
    muted
    playsinline
    aria-label={caption}
>
</video>

<style>
    .video-media {
        display: block;
        width: 100%;
        height: auto;
    }
</style>
